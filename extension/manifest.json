{
  "manifest_version": 3,
  "name": "CRM Assinaturas — Barbearias",
  "version": "0.5.0",
  "description": "CRM de assinaturas para barbearias, direto no WhatsApp Web.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://buzz-boost-crm.lovable.app/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-v5.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
