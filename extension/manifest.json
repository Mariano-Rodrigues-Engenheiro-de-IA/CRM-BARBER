{
  "manifest_version": 3,
  "name": "Zetta CRM — Tudo que você precisa em um só lugar",
  "version": "0.34.8",
  "description": "Zetta CRM: CRM completo para barbearias dentro do WhatsApp Web: assinaturas, funis, disparos e equipe.",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.whatsapp.net/*",
    "https://crm.zayloia.com/*",
    "https://buzz-boost-crm.lovable.app/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["wa-js.js", "wa-bridge-v15.js", "zetta-z.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-v15.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crm.zayloia.com/painel*",
        "https://buzz-boost-crm.lovable.app/painel*",
        "https://*.lovable.app/painel*",
        "https://*.lovableproject.com/painel*"
      ],
      "js": ["panel-nudge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
