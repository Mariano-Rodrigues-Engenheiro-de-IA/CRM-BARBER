{
  "manifest_version": 3,
  "name": "Zaylo — Tudo que você precisa em um só lugar",
  "version": "0.42.4",
  "description": "CRM completo que te ajuda a vender mais!",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.whatsapp.net/*",
    "https://crm.zayloia.com/*",
    "https://buzz-boost-crm.lovable.app/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["wa-js.js", "wa-bridge-v15.js", "zaylo-icon.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-v15.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://crm.zayloia.com/painel*",
        "https://buzz-boost-crm.lovable.app/painel*",
        "https://*.lovable.app/painel*",
        "https://*.lovableproject.com/painel*"
      ],
      "js": ["panel-nudge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
